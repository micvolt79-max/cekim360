{
  "expo": {
    "name": "Cekim360",
    "slug": "cekim360",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#000000",
    "ios": {
      "bundleIdentifier": "com.mertdikici.cekim360",
      "supportsTablet": false,
      "infoPlist": {
        "CFBundleDisplayName": "360 Çekim",
        "NSAppTransportSecurity": { "NSAllowsLocalNetworking": true },
        "NSLocalNetworkUsageDescription": "Çekilen videoları aynı ağdaki laptopa göndermek için yerel ağ erişimi gerekiyor.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "plugins": [
      [
        "react-native-vision-camera",
        {
          "cameraPermissionText": "360 video çekebilmek için kameraya erişim gerekiyor.",
          "enableMicrophonePermission": false
        }
      ]
    ]
  }
}
